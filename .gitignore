# Virtual Environment
.venv/
venv/
env/
ENV/

# Data & Datasets (Raw and Processed)
# Raw Kaggle dataset (~500MB) and derived processed artifacts are regenerable
# from scripts + raw data, so they are excluded to keep the repo small.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# NARROW exception, for deployment only: the two small (~15MB total) trained
# model/index artifacts the live demo server needs at request time
# (see src/agent.py DeltaSupportAgent.load()). Everything else under
# data/processed/ stays excluded — in particular reserved_golden_pool.parquet
# and dev_corpus.parquet, which must never be committed (the former is the
# held-out pool the golden set is sampled from). These two files contain
# only a fitted TF-IDF vectorizer/classifier and the dev-corpus evidence
# text already public in the Kaggle dataset — no secrets, no held-out data.
!data/processed/intent_classifier.pkl
!data/processed/retrieval_index.pkl
# Explains the display-only redaction applied to retrieval_index.pkl above
# (see scripts/prepare_deployment_artifacts.py) — small text file, no data.
!data/processed/DEPLOYMENT_ARTIFACT_NOTE.md
# Local-only safety backup from the redaction script; never committed.
data/processed/*.pre_redaction_backup

*.zip
*.tar.gz
*.parquet

# Generic CSV exclusion, EXCEPT:
#  - the golden evaluation set (hand-labelled deliverable, irreplaceable)
#  - the human reply-quality rating sheet (real human ratings, irreplaceable
#    once filled in — see scripts/build_human_rating_sheet.py)
*.csv
!data/golden_eval/*.csv
!data/eval/*.csv

# Credentials & Environment Variables
.env
*.env
kaggle.json

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
Thumbs.db
Desktop.ini
.DS_Store
